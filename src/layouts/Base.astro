---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Carrito from '../components/Carrito.astro';
import { MARCA } from '../data/marca';
import { url } from '../lib/url';

interface Props {
  titulo: string;
  descripcion: string;
  activo?: 'catalogo' | 'area';
}
const { titulo, descripcion, activo } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#1F2937" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:site_name" content={`${MARCA.nombreCompleto} (demo)`} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">
      Saltar al contenido
    </a>
    <Header activo={activo} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <Carrito />
  </body>
</html>
