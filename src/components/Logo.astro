---
import { MARCA } from '../data/marca';
import { url } from '../lib/url';

interface Props {
  invertido?: boolean;
}
const { invertido = false } = Astro.props;
---

<a href={url()} class="flex items-center gap-2.5">
  <svg width="36" height="36" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#3B5BFD"></rect>
    <path d="M10 23V9l12 14V9" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="22" cy="9" r="2.6" fill="#C7D2FE"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-[1.375rem] font-extrabold tracking-tight', invertido ? 'text-white' : 'text-ink']}>
      {MARCA.nombre}
    </span>
    <span class:list={['mt-1 text-[0.625rem] font-semibold uppercase tracking-[0.18em]', invertido ? 'text-slate-300' : 'text-ink-2']}>
      Suministros
    </span>
  </span>
</a>
