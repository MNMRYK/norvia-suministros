---
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  grande?: boolean;
  valor?: string;
  id?: string;
}
const { grande = false, valor = '', id = 'buscador' } = Astro.props;
---

<form action={url('catalogo/')} method="get" role="search" class="relative" data-buscador novalidate>
  <label for={id} class="sr-only">Buscar productos por referencia o nombre</label>
  <div
    class:list={[
      'flex items-center gap-2 rounded-2xl border border-line bg-white shadow-card transition focus-within:border-brand-500 focus-within:ring-4 focus-within:ring-brand-100',
      grande ? 'p-2 pl-5' : 'p-1.5 pl-4',
    ]}
  >
    <Icon name="search" size={grande ? 22 : 18} class="text-ink-2" />
    <input
      id={id}
      name="q"
      type="search"
      value={valor}
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={`${id}-lista`}
      aria-describedby={`${id}-error`}
      placeholder="Busca por referencia o nombre del producto"
      class:list={[
        'min-w-0 flex-1 bg-transparent text-ink placeholder:text-slate-500 focus:outline-none',
        grande ? 'h-12 text-[1.0625rem]' : 'h-10 text-[0.9375rem]',
      ]}
    />
    <button type="submit" class:list={['btn-primario', grande ? 'h-12 px-7 text-[0.9375rem]' : 'h-10 px-5']}>
      Buscar
    </button>
  </div>

  <p id={`${id}-error`} data-buscador-error class="mt-2 hidden items-center gap-2 text-sm font-medium text-ink" role="alert">
    <Icon name="alert" size={18} class="text-brand-600" />
    <span>Escribe una referencia o el nombre de un producto para buscar.</span>
  </p>

  <div
    id={`${id}-lista`}
    data-buscador-lista
    class="absolute inset-x-0 top-full z-30 mt-2 hidden overflow-hidden rounded-2xl border border-line bg-white shadow-lift"
  >
  </div>
</form>

<script>
  import { productos, imagenProducto, familias } from '../data/productos';
  import { euros, normalizar } from '../lib/url';

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const indice = productos.map((p) => ({ p, texto: normalizar(`${p.ref} ${p.nombre} ${p.subfamilia}`) }));

  document.querySelectorAll<HTMLFormElement>('[data-buscador]').forEach((form) => {
    const input = form.querySelector('input')!;
    const lista = form.querySelector<HTMLElement>('[data-buscador-lista]')!;
    const error = form.querySelector<HTMLElement>('[data-buscador-error]')!;
    let activo = -1;
    let resultados: typeof productos = [];

    const cerrar = () => {
      lista.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activo = -1;
    };

    const mostrarError = (ver: boolean) => {
      error.classList.toggle('hidden', !ver);
      error.classList.toggle('flex', ver);
      input.setAttribute('aria-invalid', String(ver));
    };

    const pintar = () => {
      const q = normalizar(input.value.trim());
      if (q.length < 2) return cerrar();
      const terminos = q.split(/\s+/);
      resultados = indice.filter(({ texto }) => terminos.every((t) => texto.includes(t))).map(({ p }) => p).slice(0, 6);

      if (!resultados.length) {
        lista.innerHTML = `<div class="flex items-start gap-3 p-4 text-sm" role="status">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="mt-px shrink-0 text-brand-600" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <span><strong class="font-semibold">Sin resultados para “${input.value.trim().replace(/[<>&"]/g, '')}”.</strong><br><span class="text-ink-2">Prueba con otra referencia o con un término más general, como “cable” o “válvula”.</span></span>
        </div>`;
      } else {
        lista.innerHTML =
          `<ul role="listbox" aria-label="Sugerencias" class="py-2">` +
          resultados
            .map(
              (p, i) => `<li role="option" id="${input.id}-op-${i}" aria-selected="false" data-ref="${p.ref}"
                class="flex cursor-pointer items-center gap-3 px-4 py-2.5 aria-selected:bg-brand-50 hover:bg-surface">
                <img src="${base}/${imagenProducto(p)}" alt="" width="56" height="42" class="h-[42px] w-14 rounded-lg bg-surface">
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold text-ink">${p.nombre}</span>
                  <span class="num block text-xs text-ink-2">Ref. ${p.ref} · ${familias[p.familia].corto}</span>
                </span>
                <span class="num text-sm font-bold text-ink">${euros(p.precio)}</span>
              </li>`,
            )
            .join('') +
          `</ul><a href="${form.action}?q=${encodeURIComponent(input.value.trim())}" class="flex items-center justify-between border-t border-line px-4 py-3 text-sm font-semibold text-brand-600 hover:bg-surface">Ver todos los resultados en el catálogo<span aria-hidden="true">→</span></a>`;
      }
      lista.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
      activo = -1;
    };

    const marcar = (i: number) => {
      const ops = lista.querySelectorAll<HTMLElement>('[role="option"]');
      if (!ops.length) return;
      activo = (i + ops.length) % ops.length;
      ops.forEach((o, j) => o.setAttribute('aria-selected', String(j === activo)));
      input.setAttribute('aria-activedescendant', ops[activo].id);
    };

    const ir = (ref: string) => (window.location.href = `${form.action}?q=${encodeURIComponent(ref)}`);

    input.addEventListener('input', () => {
      mostrarError(false);
      pintar();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') (e.preventDefault(), marcar(activo + 1));
      else if (e.key === 'ArrowUp') (e.preventDefault(), marcar(activo - 1));
      else if (e.key === 'Escape') cerrar();
      else if (e.key === 'Enter' && activo >= 0) {
        e.preventDefault();
        ir(resultados[activo].ref);
      }
    });
    lista.addEventListener('click', (e) => {
      const op = (e.target as HTMLElement).closest<HTMLElement>('[data-ref]');
      if (op) ir(op.dataset.ref!);
    });
    form.addEventListener('submit', (e) => {
      if (!input.value.trim()) {
        e.preventDefault();
        mostrarError(true);
        input.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) cerrar();
    });
  });
</script>
