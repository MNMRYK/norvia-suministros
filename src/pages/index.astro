---
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Buscador from '../components/Buscador.astro';
import ProductCard from '../components/ProductCard.astro';
import { MARCA } from '../data/marca';
import { familias, productos, type FamiliaId } from '../data/productos';
import { url } from '../lib/url';

const ventajas: { icono: IconName; titulo: string; texto: string }[] = [
  { icono: 'truck', titulo: 'Entrega en 24 h', texto: "En l'Alcoià, El Comtat e Ibi" },
  { icono: 'tag', titulo: 'Tarifa profesional', texto: "Descuentos por volumen" },
  { icono: 'warehouse', titulo: 'Recogida en almacén', texto: 'Pide online y recoge en 1 h' },
  { icono: 'headset', titulo: 'Asesoramiento técnico', texto: 'Te ayudamos a elegir' },
];

const iconoFamilia: Record<FamiliaId, IconName> = { electrico: 'zap', fontaneria: 'droplet', industrial: 'wrench' };

const destacados = productos.filter((p) => p.destacado).slice(0, 4);

const servicios: { icono: IconName; titulo: string; texto: string }[] = [
  { icono: 'scissors', titulo: 'Corte de cable a medida', texto: 'El metraje exacto, sin pagar rollos completos.' },
  { icono: 'zap', titulo: 'Cuadros premontados', texto: 'Preparamos tus cuadros de protección listos para instalar.' },
  { icono: 'droplet', titulo: 'Latiguillos a medida', texto: 'Montaje de latiguillos y flexibles en el mostrador.' },
  { icono: 'repeat', titulo: 'Recogida de residuos', texto: 'Entréganos lámparas y aparatos usados para su reciclaje.' },
];

const lineas = [
  { nombre: 'Norvia Pro', texto: 'Gama profesional para instalación diaria' },
  { nombre: 'Norvia Basic', texto: 'Consumibles y fijación al mejor precio' },
  { nombre: 'Norvia Work', texto: 'EPIs y herramienta para taller y obra' },
];
---

<Base
  titulo={`${MARCA.nombreCompleto} · Material eléctrico, fontanería y suministro industrial en Alcoy`}
  descripcion="Almacén distribuidor para profesionales en Alcoy y comarca: material eléctrico, fontanería y suministro industrial con tarifa profesional y entrega en 24 h. Web de demostración."
>
  <link slot="head" rel="preload" as="image" href={url('img/fotos/hero-960.webp')} imagesrcset={`${url('img/fotos/hero-640.webp')} 640w, ${url('img/fotos/hero-960.webp')} 960w, ${url('img/fotos/hero-1280.webp')} 1280w`} imagesizes="(min-width: 1024px) 560px, 100vw" fetchpriority="high" />

  <!-- HERO -->
  <section class="relative overflow-hidden bg-linear-to-b from-white to-surface">
    <div aria-hidden="true" class="pointer-events-none absolute -top-40 right-[-10%] h-[640px] w-[640px] rounded-full bg-brand-50 blur-3xl"></div>

    <div class="contenedor relative pt-10 pb-12 lg:pt-12 lg:pb-14">
      <div class="grid grid-cols-1 items-center gap-10 *:min-w-0 lg:grid-cols-[1.08fr_1fr] lg:gap-14">
        <div>
          <p class="eyebrow">
            <span class="size-1.5 rounded-full bg-brand-500"></span>
            Material eléctrico · Fontanería · Suministro industrial
          </p>
          <h1 class="mt-5 font-display text-[2.5rem] leading-[1.05] font-extrabold tracking-tight text-ink sm:text-5xl lg:text-[3.625rem]">
            Todo para tu instalación, <span class="block text-brand-500">listo en 24&nbsp;h.</span>
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-2">
            Almacén distribuidor en Alcoy para instaladores, talleres y empresas de {MARCA.zona}. Tarifa profesional,
            stock real y reparto propio.
          </p>

          <div class="mt-8 max-w-[620px]">
            <Buscador grande id="buscador-hero" />
            <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
              <span class="text-ink-2">Lo más buscado:</span>
              {
                ['Cable 2,5 mm²', 'Multicapa 20', 'Rodamiento 6204'].map((t) => (
                  <a
                    href={url(`catalogo/?q=${encodeURIComponent(t)}`)}
                    class="rounded-full border border-line bg-white px-3 py-1 font-medium text-ink transition-colors hover:border-brand-300 hover:text-brand-600"
                  >
                    {t}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div class="relative lg:pl-4">
          <div class="relative overflow-hidden rounded-[20px] shadow-lift">
            <img
              src={url('img/fotos/hero-960.webp')}
              srcset={`${url('img/fotos/hero-640.webp')} 640w, ${url('img/fotos/hero-960.webp')} 960w, ${url('img/fotos/hero-1280.webp')} 1280w`}
              sizes="(min-width: 1024px) 560px, 100vw"
              width="960"
              height="640"
              alt="Pasillo del almacén con estanterías llenas de material"
              fetchpriority="high"
              class="aspect-[4/3] w-full object-cover lg:aspect-[11/10]"
            />
            <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-ink/25 via-transparent to-transparent"></div>
          </div>

          <!-- Tarjeta flotante: pedido en reparto -->
          <div class="absolute bottom-6 left-4 w-[min(340px,calc(100%-2rem))] rounded-2xl border border-line bg-white p-4 shadow-lift sm:left-[-2rem] lg:bottom-10 lg:left-[-2.5rem]">
            <div class="flex items-center gap-3">
              <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-600">
                <Icon name="truck" size={22} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="num font-display text-[0.9375rem] font-extrabold whitespace-nowrap">Pedido NV-2418</p>
                <p class="text-xs text-ink-2">Instalaciones Ejemplo S.L.</p>
              </div>
              <span class="inline-flex items-center gap-1 rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-600">
                <span class="size-1.5 animate-pulse rounded-full bg-brand-500"></span>En reparto
              </span>
            </div>
            <ol class="mt-4 grid grid-cols-3 gap-1.5" aria-label="Estado del pedido">
              <li class="h-1.5 rounded-full bg-brand-500"><span class="sr-only">Preparado: completado</span></li>
              <li class="h-1.5 rounded-full bg-brand-500"><span class="sr-only">En reparto: en curso</span></li>
              <li class="h-1.5 rounded-full bg-line"><span class="sr-only">Entregado: pendiente</span></li>
            </ol>
            <p class="mt-2.5 flex items-center gap-1.5 text-xs text-ink-2">
              <Icon name="clock" size={14} /> Llega hoy antes de las 13:00 · 14 líneas
            </p>
          </div>
        </div>
      </div>

      <!-- Banda de ventajas -->
      <ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line shadow-card sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
        {
          ventajas.map((v) => (
            <li class="flex items-center gap-4 bg-white px-6 py-5">
              <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-600">
                <Icon name={v.icono} size={22} />
              </span>
              <span>
                <span class="block font-display text-[0.9375rem] font-bold text-ink">{v.titulo}</span>
                <span class="block text-sm text-ink-2">{v.texto}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAMILIAS -->
  <section class="bg-surface py-12" aria-labelledby="t-familias">
    <div class="contenedor">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="t-familias" class="titulo-seccion">Tres familias, un solo proveedor</h2>
          <p class="mt-2 text-ink-2">Todo el material para tu instalación en un mismo pedido y una misma factura.</p>
        </div>
        <a href={url('catalogo/')} class="inline-flex items-center gap-1.5 font-semibold text-brand-600 hover:text-brand-700">
          Ver catálogo completo <Icon name="arrow-right" size={18} />
        </a>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          (Object.entries(familias) as [FamiliaId, (typeof familias)[FamiliaId]][]).map(([id, f]) => (
            <a
              href={url(`catalogo/?familia=${id}`)}
              class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-card transition hover:-translate-y-0.5 hover:shadow-lift"
            >
              <div class="relative">
                <img
                  src={url(`img/fotos/${f.foto}-480.webp`)}
                  srcset={`${url(`img/fotos/${f.foto}-480.webp`)} 480w, ${url(`img/fotos/${f.foto}-800.webp`)} 800w`}
                  sizes="(min-width: 768px) 400px, 100vw"
                  width="480"
                  height="320"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="aspect-5/2 w-full object-cover"
                />
                <span class="absolute bottom-0 left-6 grid size-12 translate-y-1/2 place-items-center rounded-xl bg-brand-500 text-white shadow-card">
                  <Icon name={iconoFamilia[id]} size={22} />
                </span>
              </div>
              <div class="flex flex-1 flex-col p-6 pt-9">
                <h3 class="flex items-center justify-between font-display text-xl font-extrabold">
                  {f.nombre}
                  <Icon name="arrow-right" size={20} class="text-brand-600 transition-transform group-hover:translate-x-0.5" />
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-2">{f.descripcion}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- DESTACADOS -->
  <section class="py-12" aria-labelledby="t-destacados">
    <div class="contenedor">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="t-destacados" class="titulo-seccion">Productos destacados</h2>
        </div>
        <a href={url('catalogo/')} class="inline-flex items-center gap-1.5 font-semibold text-brand-600 hover:text-brand-700">
          Ver todos <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {destacados.map((p) => <ProductCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- SERVICIOS + MARCAS -->
  <section id="servicios" class="bg-surface py-12" aria-labelledby="t-servicios">
    <div class="contenedor grid gap-10 lg:grid-cols-[1.55fr_1fr] lg:gap-14">
      <div>
        <h2 id="t-servicios" class="titulo-seccion">Servicios para profesionales</h2>
        <ul class="mt-7 grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            servicios.map((s) => (
              <li class="flex gap-4">
                <span class="grid size-11 place-items-center rounded-xl bg-white text-brand-600 shadow-card">
                  <Icon name={s.icono} size={22} />
                </span>
                <div>
                  <h3 class="font-display text-base font-bold">{s.titulo}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-ink-2">{s.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="marcas" class="self-start rounded-2xl border border-line bg-white p-6 shadow-card">
        <h2 class="font-display text-xl font-extrabold">Marcas y líneas de producto</h2>
        <p class="mt-1 text-sm text-ink-2">Líneas propias y material de fabricantes nacionales y europeos.</p>
        <ul class="mt-4 space-y-2">
          {
            lineas.map((l) => (
              <li class="flex items-center gap-3 rounded-xl bg-surface px-4 py-2.5">
                <Icon name="layers" size={20} class="text-brand-600" />
                <span class="font-display text-sm font-extrabold">{l.nombre}</span>
                <span class="text-xs text-ink-2">{l.texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- HAZTE CLIENTE PROFESIONAL -->
  <section id="cliente-profesional" class="py-12" aria-labelledby="t-cliente">
    <div class="contenedor">
      <div class="grid overflow-hidden rounded-[20px] bg-ink lg:grid-cols-[1.15fr_1fr]">
        <div class="p-8 sm:p-10">
          <h2 id="t-cliente" class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            Hazte cliente profesional
          </h2>
          <p class="mt-3 max-w-lg text-slate-300">
            Abre tu cuenta en un día laborable y trabaja con condiciones pensadas para quien compra cada semana.
          </p>
          <ul class="mt-6 grid gap-5 sm:grid-cols-3">
            {
              [
                { i: 'percent', t: 'Tarifas personalizadas', d: 'Descuentos por familia según tu volumen.' },
                { i: 'repeat', t: 'Pedidos recurrentes', d: 'Repite un pedido anterior con un clic.' },
                { i: 'file', t: 'Facturas online', d: 'Descárgalas cuando quieras desde tu área.' },
              ].map((b) => (
                <li>
                  <span class="grid size-10 place-items-center rounded-lg bg-brand-500 text-white">
                    <Icon name={b.i as IconName} size={20} />
                  </span>
                  <h3 class="mt-3 font-display text-sm font-bold text-white">{b.t}</h3>
                  <p class="mt-1 text-sm text-slate-300">{b.d}</p>
                </li>
              ))
            }
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`mailto:${MARCA.email}?subject=Alta%20cliente%20profesional`} class="btn-primario h-12 px-6 text-[0.9375rem]">
              Solicitar alta <Icon name="arrow-right" size={18} />
            </a>
            <a href={url('area-clientes/')} class="btn h-12 border border-white/20 px-6 text-[0.9375rem] text-white hover:bg-white/10">
              Ya soy cliente
            </a>
          </div>
        </div>
        <div class="relative hidden min-h-[360px] lg:block">
          <img
            src={url('img/fotos/almacen-640.webp')}
            width="640"
            height="853"
            alt=""
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover opacity-90"
          />
          <div class="absolute right-8 bottom-8 left-8 rounded-2xl bg-white p-5 shadow-lift">
            <div class="flex items-center justify-between">
              <p class="text-xs font-semibold tracking-wide text-ink-2 uppercase">Tu tarifa · ejemplo</p>
              <Icon name="percent" size={18} class="text-brand-600" />
            </div>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between"><span>Material eléctrico</span><span class="num font-bold text-brand-600">−18 %</span></li>
              <li class="flex justify-between"><span>Fontanería</span><span class="num font-bold text-brand-600">−15 %</span></li>
              <li class="flex justify-between"><span>Suministro industrial</span><span class="num font-bold text-brand-600">−12 %</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
